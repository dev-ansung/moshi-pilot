# Moshi-Pilot — environment variables (optional for live mode; demo mode runs keyless)

# Vapi — voice orchestration & outbound SIP calling
VAPI_API_KEY=your_vapi_api_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# Deepgram — nova-2 Japanese speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key

# TypeSafe / Jev — structured HITL decision engine
TYPESAFE_JEV_API_KEY=your_jev_api_key

# Exa — neural web search for pre-call venue grounding
EXA_API_KEY=your_exa_api_key

# Manus — post-call workflow automation & receipt dispatch
MANUS_API_KEY=your_manus_api_key
MANUS_WEBHOOK_SECRET=your_manus_webhook_secret
